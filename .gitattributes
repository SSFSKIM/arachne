# Declare files that always have LF line endings on checkout
* text eol=lf
*.bat  text eol=crlf

# Denote all files that are truly binary and should not be modified
*.npz binary
*.png binary
*.wav binary

manim/grpc/gen/** linguist-generated=true

# Upstream sources, kept byte for byte but for the one change sim/vendor/VENDORED.md records; the
# pre-commit hooks skip them too.
sim/vendor/** linguist-vendored=true
